# Contact Form Service Keys (Choose either Web3Forms or Formspree)

# Option 1: Web3Forms (Free, get key at https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Option 2: Formspree (Free, get endpoint at https://formspree.io)
# VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/your_form_id_here

# Optional: Force custom cursor in testing/preview environments
# VITE_FORCE_CURSOR=true
